# %% [7] CUSTOM CROSSTABS WITH CHI-SQUARE AND BONFERRONI-ADJUSTED COMPARISONS --
# Approximate equivalent of SPSS CTABLES /SIGTEST TYPE=CHISQUARE
# /COMPARETEST TYPE=PROP ADJUST=BONFERRONI. Printed to console for full
# transparency; NOT saved as images (there are 75 combinations), only the
# summary results below are saved.
_deposit_vars = ["P2R", "P3", "P4", "P5", "P6", "P7", "P8", "P9", "P73R",
                  "P74", "P75", "P76", "P77", "P78", "P79"]
_group_vars = ["KnowsOA", "Gender", "AgeGroup", "Discipline", "CenterTypeLabel"]

def crosstab_with_tests(row_var, col_var, alpha=0.05):
    sub = df[[row_var, col_var]].dropna()
    if sub.empty:
        return None
    ct = pd.crosstab(sub[row_var], sub[col_var])
    colpct = (ct / ct.sum(axis=0) * 100).round(1)
    chi2, p, dof, _ = stats.chi2_contingency(ct)

    levels = list(ct.columns)
    pairs = list(combinations(levels, 2))
    n_comp = max(len(pairs), 1)
    significant_pairs = {}
    for cat in ct.index:
        sig = []
        for c1, c2 in pairs:
            n1, n2 = ct[c1].sum(), ct[c2].sum()
            x1, x2 = ct.loc[cat, c1], ct.loc[cat, c2]
            p1, p2 = x1 / n1, x2 / n2
            p_pool = (x1 + x2) / (n1 + n2)
            se = np.sqrt(p_pool * (1 - p_pool) * (1 / n1 + 1 / n2))
            if se == 0:
                continue
            z = (p1 - p2) / se
            p_val = 2 * (1 - stats.norm.cdf(abs(z)))
            if p_val * n_comp < alpha:
                sig.append((c1, c2, round(p_val * n_comp, 4)))
        significant_pairs[cat] = sig
    return {"counts": ct, "colpct": colpct, "chi2": chi2, "p": p, "dof": dof, "sig_pairs": significant_pairs}

print("\n" + "=" * 90)
print("CUSTOM TABLES: deposit variables x sociodemographic variables (printed only)")
print("=" * 90)
for _row in _deposit_vars:
    for _col in _group_vars:
        res = crosstab_with_tests(_row, _col)
        if res is None:
            continue
        print(f"\n--- {_row} x {_col} ---")
        print("Counts:\n", res["counts"])
        print("Column %:\n", res["colpct"])
        print(f"Chi-square = {res['chi2']:.3f}, df = {res['dof']}, p = {res['p']:.4f}")
        for cat, sig in res["sig_pairs"].items():
            if sig:
                print(f"  Significant Bonferroni-adjusted proportion comparisons for category '{cat}':")
                for c1, c2, pv in sig:
                    print(f"    {c1} vs {c2} (adjusted p = {pv})")


