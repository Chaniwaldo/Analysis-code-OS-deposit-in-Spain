def standardized_beta(fit, X, y):
    sy = y.std()
    return {c: fit.params[c] * X[c].std() / sy for c in fit.params.index if c != "const"}

beta_articles = standardized_beta(ols_articles, X_art, y_art)
beta_data = standardized_beta(ols_data, X_dat, y_dat)

def sig_stars(p):
    if p < 0.001: return "***"
    if p < 0.01: return "**"
    if p < 0.05: return "*"
    return ""

def format_or(coef, p):
    txt = f"{np.exp(coef):.3f}{sig_stars(p)}"
    if p < 0.05:
        txt += f" ({p:.3f})"
    return txt

def format_beta(beta, p):
    txt = f"{beta:.3f}{sig_stars(p)}"
    if p < 0.05:
        txt += f" ({p:.3f})"
    return txt

