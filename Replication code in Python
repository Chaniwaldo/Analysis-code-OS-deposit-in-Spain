#!/usr/bin/env python
# ==============================================================================
# REPLICATION SCRIPT (Python translation of SPSS syntax)
# Open Science deposit behaviour among Spanish researchers
# Data source: Olle-Castella et al. (2023), CSUC Dataverse, doi:10.34810/DATA690
# Original SPSS syntax: "Replication-code-in-SPSS-v1-2.sps"
# ==============================================================================
#
# WHAT THIS SCRIPT DOES
# ----------------------------------------------------------------------------
# 1. Loads the RAW original survey export (.csv, ~1.3 MB, full question text
#    as column headers) from the path you specify below.
# 2. Converts it into an INTERMEDIATE Excel file, applying the same variable
#    renaming (P1...P141) and category recoding used in the original SPSS
#    workflow, so that categorical answers are expressed with the same codes
#    used throughout the published analysis.
# 3. Re-loads the data FROM that intermediate Excel file and performs all the
#    data-management steps described in the SPSS syntax (recodes, derived
#    variables, dummy variables, composite indices).
# 4. Reproduces the SPSS analyses (frequency tables, custom crosstabs with
#    chi-square and Bonferroni-adjusted pairwise comparisons, linear
#    regression, logistic regression) using statsmodels, which implements
#    the same OLS / Maximum-Likelihood Logit estimators as SPSS REGRESSION
#    and LOGISTIC REGRESSION, so coefficients, standard errors and
#    significance levels should be numerically equivalent (see the caveats
#    printed at the end of the script for the small sources of divergence
#    that remain, e.g. optimizer tolerance).
# 5. Prints every intermediate table to the console for full transparency,
#    but only SAVES the final, most important tables as PNG images inside a
#    "Results" folder (created automatically next to this script):
#       - Results/Descriptive_frequencies.png
#       - Results/Table1_regression_results.png   <-- main deliverable,
#         reproducing the "Table 1. Results for regression models" table.
#
# HOW TO USE THIS SCRIPT (for reproducibility / replication by other
# researchers)
# ----------------------------------------------------------------------------
# 1. Install the required packages (only needs to be done once):
#
#       pip install pandas numpy scipy statsmodels matplotlib openpyxl
#
#    (If you use Anaconda, these are normally already installed; if you get
#    an ImportError when running this script, run the pip command above in
#    the same Python environment you use to run this script.)
#
# 2. Edit the RAW_CSV_PATH variable below and point it to the location of the
#    original raw CSV export on your own computer, e.g.:
#
#       RAW_CSV_PATH = r"C:\Users\yourname\Data\respostes_personal_investigador_2023_04_11.csv"
#
# 3. Run the script (e.g. `python replication_script.py`, or execute it cell
#    by cell in Jupyter using the "# %%" cell markers).
#
# 4. Check the "Results" folder for the final tables saved as images.
#
# ==============================================================================

# %% [0] PACKAGE CHECK -----------------------------------------------------------
# This block only checks that the required third-party packages are
# available and gives a clear instruction if they are not, instead of
# failing with a cryptic ImportError deep inside the script.
REQUIRED_PACKAGES = ["pandas", "numpy", "scipy", "statsmodels", "matplotlib", "openpyxl"]
_missing = []
for _pkg in REQUIRED_PACKAGES:
    try:
        __import__(_pkg)
    except ImportError:
        _missing.append(_pkg)
if _missing:
    raise ImportError(
        "Missing required packages: " + ", ".join(_missing) +
        ".\nPlease install them first by running:\n\n"
        "    pip install " + " ".join(REQUIRED_PACKAGES) + "\n"
    )

