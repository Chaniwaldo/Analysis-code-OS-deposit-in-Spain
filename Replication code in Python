def prepare_model_data(dependent, predictors):
    sub = df[[dependent] + predictors].dropna().copy()
    X = sm.add_constant(sub[predictors])
    y = sub[dependent]
    return X, y

def anova_table_from_ols(fit):
    """ANOVA table (Regression / Residual / Total) built directly from an
    sm.OLS fit on arrays (no patsy design_info required), reproducing the
    same table SPSS REGRESSION prints."""
    rows = {
        "Regression": [fit.df_model, fit.ess, fit.mse_model, fit.fvalue, fit.f_pvalue],
        "Residual":   [fit.df_resid, fit.ssr, fit.mse_resid, np.nan, np.nan],
        "Total":      [fit.df_model + fit.df_resid, fit.centered_tss, np.nan, np.nan, np.nan],
    }
    return pd.DataFrame(rows, index=["df", "Sum of Squares", "Mean Square", "F", "Sig."]).T.round(4)

def coefficients_table(fit, kind="ols"):
    conf = fit.conf_int()
    conf.columns = ["CI95% lower", "CI95% upper"]
    out = pd.DataFrame({"B": fit.params, "Std. Error": fit.bse})
    if kind == "ols":
        out["t"] = fit.tvalues
        out["Sig."] = fit.pvalues
    else:
        out["Wald (z)"] = fit.tvalues
        out["Sig."] = fit.pvalues
        out["OR = Exp(B)"] = np.exp(fit.params)
        conf = np.exp(conf)
        conf.columns = ["CI95% OR lower", "CI95% OR upper"]
    return pd.concat([out, conf], axis=1).round(4)


# %% [9] LINEAR REGRESSION (SPSS REGRESSION) -------------------------------------
X_art, y_art = prepare_model_data("ArticleDepositIndex", PREDICTORS)
ols_articles = sm.OLS(y_art, X_art).fit()
X_dat, y_dat = prepare_model_data("DataDepositIndex", PREDICTORS)
ols_data = sm.OLS(y_dat, X_dat).fit()

for name, fit in [("ArticleDepositIndex", ols_articles), ("DataDepositIndex", ols_data)]:
    print(f"\n===== Linear regression: {name} =====")
    print(pd.DataFrame({
        "R": [np.sqrt(fit.rsquared)], "R-squared": [fit.rsquared],
        "Adj. R-squared": [fit.rsquared_adj], "Std. Error of estimate": [np.sqrt(fit.mse_resid)],
    }).round(4))
    print("\nANOVA table")
    print(anova_table_from_ols(fit))
    print("\nCoefficients")
    print(coefficients_table(fit, "ols"))


# %% [10] LOGISTIC REGRESSION (SPSS LOGISTIC REGRESSION) -------------------------
def run_logistic(dependent, predictors, label):
    X, y = prepare_model_data(dependent, predictors)
    fit = sm.Logit(y, X).fit(disp=0)
    print(f"\n===== Logistic regression: {label} =====")
    print(f"N = {int(fit.nobs)} | -2LL null = {-2*fit.llnull:.3f} | -2LL model = {-2*fit.llf:.3f}")
    print(f"Model chi-square = {fit.llr:.3f} (df={int(fit.df_model)}, p={fit.llr_pvalue:.4f})")
    print(f"Nagelkerke R-squared (approx.) = {1 - np.exp(-fit.llr/fit.nobs):.4f}")
    pred_prob = fit.predict(X)
    pred_class = (pred_prob >= 0.5).astype(int)
    classification = pd.crosstab(y, pred_class, rownames=["Observed"], colnames=["Predicted"])
    accuracy = float(np.mean(pred_class == y) * 100)
    print(f"\nClassification table (cutoff 0.5) - overall % correct = {accuracy:.1f}%")
    print(classification)
    print("\nCoefficients (B, Wald, Sig., OR, 95% CI of OR)")
    print(coefficients_table(fit, "logit"))
    return fit

log_articles = run_logistic("HasDepositedArticles", PREDICTORS, "HasDepositedArticles")
log_data = run_logistic("HasDepositedData", PREDICTORS, "HasDepositedData")


